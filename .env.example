# Optional API keys — never commit real secrets
# CoinGecko free API works without a key; Pro key is optional
COINGECKO_API_KEY=
# Etherscan / block explorer (optional, for wallet public balance lookups)
ETHERSCAN_API_KEY=
# Feature flag override: set to 1 to unlock PRO UI locally (no payment)
MCCC_PRO_UNLOCK=0
# Local admin gate for Partner Links / Admin pages (DEMO default if unset: mccc-admin-demo)
MCCC_ADMIN_PASSWORD=
# Promote matching registered user to is_admin on boot / login
MCCC_BOOTSTRAP_ADMIN_EMAIL=
# Dev diagnostics page (pages/23_Diagnostics.py) + Admin Diagnostics tab
MCCC_DEV=0
# Optional Free-tier soft limits (defaults: 10 / 5 / 15)
# MCCC_FREE_MAX_PROJECTS=10
# MCCC_FREE_MAX_WALLETS=5
# MCCC_FREE_MAX_AIRDROPS=15
# Optional OpenAI-compatible API for AI assistant (empty = rule-based only)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional cookie/session salt for auth helpers
AUTH_SECRET=
# Optional; SQLite path is managed locally — DATABASE_URL is ignored for now
DATABASE_URL=
